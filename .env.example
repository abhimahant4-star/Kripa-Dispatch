# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/kirpa_dispatch
# Long random string used to sign login sessions
JWT_SECRET=change-me-to-a-long-random-string
# First admin account created by `npm run seed`
SEED_ADMIN_EMAIL=admin@kirpadispatch.com
SEED_ADMIN_PASSWORD=change-this-password

# Shown on printed invoices (optional)
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_MC=
NEXT_PUBLIC_COMPANY_DOT=
# Canadian GST/HST registration number (optional)
NEXT_PUBLIC_COMPANY_GST_HST=

# Billing currency: USD (default) or CAD
NEXT_PUBLIC_CURRENCY=USD
